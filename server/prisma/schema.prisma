generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  username     String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  characters   Character[]

  // Account-level character-slot cap. Starts at 1; a future Story & PvE Campaign agent
  // grants more via grantCharacterSlot() when the player clears specific chapters.
  unlockedCharacterSlots Int @default(1)

  // Which of this account's characters is currently "active" for battle/equip/shop
  // routes that don't take an explicit characterId. Not a Prisma relation (kept as a
  // plain id) so ownership validation stays in application code.
  activeCharacterId String?
}

model Character {
  id        String   @id @default(uuid())
  owner     User     @relation(fields: [ownerId], references: [id])
  ownerId   String
  name      String
  // Ordering key for the character-select screen (a UUID id isn't creation-ordered).
  createdAt DateTime @default(now())
  // Null until the first class-unlock threshold is crossed. Informational display field
  // ("first class unlocked") once set — skill access is driven by unlockedClasses.
  jobClass  String?
  level     Int    @default(1)
  xp        Int    @default(0)
  unallocatedStatPoints Int  @default(0)
  unlockedClasses       Json @default("[]")
  currentWinStreak Int @default(0)
  // PvP queue bot-fallback opt-out (server/src/game/matchmaking.ts). When false, this
  // character never gets matched with a synthetic bot and keeps waiting for a human instead.
  allowBotMatches Boolean @default(true)
  dryStreakWeapon    Int @default(0)
  dryStreakArmor     Int @default(0)
  dryStreakAccessory Int @default(0)
  currency           Int @default(0)
  purchasesToday     Json @default("{}")
  purchasesTodayDate String?
  // Story & PvE Campaign: chapter ids this character has first-cleared.
  completedChapterIds Json @default("[]")
  // Per-chapter { physical, magical } action tally against that chapter's boss, accumulated
  // across every attempt — read by the campaign AI's adaptive-defense rule.
  campaignBossMemory  Json @default("{}")
  maxHp     Int
  hp        Int
  maxMp     Int
  mp        Int
  attack    Int
  defense   Int
  magic     Int
  speed     Int
  spriteKey String
  inventory Json   @default("{}")

  // These reference a CharacterEquipmentInstance's id, not a catalog item id directly.
  equippedWeaponId    String?
  equippedArmorId     String?
  equippedAccessoryId String?

  equipmentInstances CharacterEquipmentInstance[]

  @@index([ownerId])
}

model CharacterEquipmentInstance {
  id            String    @id @default(uuid())
  character     Character @relation(fields: [characterId], references: [id])
  characterId   String
  catalogItemId String

  // Reserved for a future Enhancement/Fusion phase — no gameplay effect yet.
  enhancementLevel Int @default(0)

  // "loot" | "shop"
  acquiredVia String

  // UTC "YYYY-MM-DD", set only when acquiredVia is "shop" — used by the Shop system for
  // same-day full-refund eligibility instead of a separate tracking map.
  purchasedDate String?

  createdAt DateTime @default(now())

  @@index([characterId])
}
